# Copy this file to .env and adjust as needed. Must include /api.
# Production (default if unset):
# EXPO_PUBLIC_API_BASE_URL=https://campusverse-s56y.onrender.com/api

# Local dev — Android emulator:
# EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:5000/api

# Local dev — physical device on same WiFi (replace with your machine's LAN IPv4):
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.25:5000/api
EXPO_PUBLIC_API_BASE_URL=https://campusverse-s56y.onrender.com/api

# Production CampusVerse frontend SPA (deployed separately, e.g. certificate verification pages).
EXPO_PUBLIC_WEB_APP_URL=https://campusverse-nu.vercel.app
